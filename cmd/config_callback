#!/bin/bash

# This script is called after the user change environment variables in application setting page.
# Update the core type selection

# 获取用户选择的核心类型
CORE_TYPE="${wizard_core_type:-v2ray}"

# 创建环境变量配置文件
ENV_CONFIG_DIR="${TRIM_PKGVAR}/env"
mkdir -p "${ENV_CONFIG_DIR}"

# 保存核心类型到配置文件
echo "${CORE_TYPE}" > "${ENV_CONFIG_DIR}/CORE_TYPE"

echo "Core type selection updated: ${CORE_TYPE}"

exit 0
