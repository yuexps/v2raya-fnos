#!/bin/bash

# 日志与 PID 文件位置
LOG_FILE="${TRIM_PKGVAR}/v2raya.log"
PID_FILE="${TRIM_PKGVAR}/v2raya.pid"
ADAPTER_PID_FILE="${TRIM_PKGVAR}/adapter.pid"

# 日志函数
log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

# 错误处理并退出
error_exit() {
    log_msg "错误: $1"
    if [ -n "${TRIM_TEMP_LOGFILE}" ]; then
        echo "$1" > "${TRIM_TEMP_LOGFILE}"
    fi
    exit 1
}

# 获取系统架构
ARCH=$(uname -m)
case "${ARCH}" in
    x86_64)  ARCH="x86" ;;
    aarch64) ARCH="arm" ;;
    *)       error_exit "不支持的系统架构: ${ARCH}" ;;
esac

# 内核与服务路径配置
CORE_TYPE="v2raya_core"
CORE_BIN="${TRIM_APPDEST}/${ARCH}/${CORE_TYPE}"
V2RAYA_BIN="${TRIM_APPDEST}/${ARCH}/v2raya"
CORE_ASSETSDIR="${TRIM_APPDEST}/geo"
SOCK_FILE="${TRIM_APPDEST}/v2raya.sock"
SOCK_FILE_REAL="${TRIM_APPDEST}/v2raya_real.sock"
ADAPTER_SCRIPT="${TRIM_APPDEST}/gateway_adapter.py"
PYTHON_BIN="/usr/bin/python3"

# 检查可执行程序完整性
[ ! -f "${CORE_BIN}" ] && error_exit "未找到核心程序: ${CORE_BIN}"
[ ! -f "${V2RAYA_BIN}" ] && error_exit "未找到 v2rayA 主程序: ${V2RAYA_BIN}"
[ ! -f "${ADAPTER_SCRIPT}" ] && error_exit "未找到网关适配脚本: ${ADAPTER_SCRIPT}"

# 导出环境变量
export V2RAYA_SOCKET="${SOCK_FILE_REAL}"
export V2RAY_LOCATION_ASSET="${CORE_ASSETSDIR}"
export XRAY_LOCATION_ASSET="${CORE_ASSETSDIR}"
export V2RAYA_CORE_TYPE="v2raya_core"
export V2RAYA_BASEURL="/app/v2raya"

# v2rayA 启动参数
CMD_ARGS="--config ${TRIM_PKGVAR} \
--v2ray-bin ${CORE_BIN} \
--v2ray-assetsdir ${CORE_ASSETSDIR} \
--log-file ${LOG_FILE} \
--log-level info \
--log-max-days 3"

# 获取 v2rayA 进程 PID
get_v2raya_pid() {
    pgrep -f "${V2RAYA_BIN}" | head -n 1
}

get_adapter_pid() {
    pgrep -f "${ADAPTER_SCRIPT}" | head -n 1
}

# 检查状态
status() {
    local v_pid=$(get_v2raya_pid)
    local a_pid=$(get_adapter_pid)
    if [ -n "${v_pid}" ] && [ -n "${a_pid}" ]; then
        echo "${v_pid}" > "${PID_FILE}"
        echo "${a_pid}" > "${ADAPTER_PID_FILE}"
        return 0
    fi
    [ -z "${v_pid}" ] && rm -f "${PID_FILE}"
    [ -z "${a_pid}" ] && rm -f "${ADAPTER_PID_FILE}"
    return 1
}

# 启动进程
start_process() {
    if status; then
        log_msg "v2rayA 已经在运行中"
        return 0
    fi

    log_msg "正在启动 v2rayA ..."
    rm -f "${SOCK_FILE}" "${SOCK_FILE_REAL}"

    nohup "${V2RAYA_BIN}" ${CMD_ARGS} >> "${LOG_FILE}" 2>&1 &
    
    local count=0
    while [ ! -S "${SOCK_FILE_REAL}" ] && [ $count -lt 10 ]; do
        sleep 0.5
        ((count++))
    done

    local new_vpid=$(get_v2raya_pid)
    if [ -z "${new_vpid}" ]; then
        error_exit "v2rayA 启动失败，请检查日志: ${LOG_FILE}"
    fi
    echo "${new_vpid}" > "${PID_FILE}"
    log_msg "v2rayA 已启动 (Unix Socket)，PID: ${new_vpid}"

    nohup "${PYTHON_BIN}" "${ADAPTER_SCRIPT}" --listen "${SOCK_FILE}" --target "${SOCK_FILE_REAL}" >> "${LOG_FILE}" 2>&1 &
    
    count=0
    while [ ! -S "${SOCK_FILE}" ] && [ $count -lt 10 ]; do
        sleep 0.5
        ((count++))
    done

    local new_apid=$(get_adapter_pid)
    if [ -n "${new_apid}" ]; then
        echo "${new_apid}" > "${ADAPTER_PID_FILE}"
        chmod 666 "${SOCK_FILE}" 2>/dev/null || true
        return 0
    else
        error_exit "网关适配器启动失败，请检查日志: ${LOG_FILE}"
    fi
}

# 停止进程
stop_process() {
    log_msg "正在停止 v2rayA ..."
    local a_pid=$(get_adapter_pid)
    local v_pid=$(get_v2raya_pid)

    [ -n "${a_pid}" ] && kill -TERM "${a_pid}" 2>/dev/null || true
    [ -n "${v_pid}" ] && kill -TERM "${v_pid}" 2>/dev/null || true

    local count=0
    while [ $count -lt 10 ]; do
        v_pid=$(get_v2raya_pid)
        a_pid=$(get_adapter_pid)
        if [ -z "${v_pid}" ] && [ -z "${a_pid}" ]; then
            log_msg "v2rayA 已停止"
            rm -f "${PID_FILE}" "${ADAPTER_PID_FILE}"
            rm -f "${SOCK_FILE}" "${SOCK_FILE_REAL}"
            return 0
        fi
        sleep 1
        ((count++))
    done

    v_pid=$(get_v2raya_pid)
    a_pid=$(get_adapter_pid)
    if [ -n "${v_pid}" ] || [ -n "${a_pid}" ]; then
        log_msg "进程未响应，正在强制关闭 v2rayA (SIGKILL)"
        [ -n "${v_pid}" ] && kill -9 "${v_pid}" 2>/dev/null || true
        [ -n "${a_pid}" ] && kill -9 "${a_pid}" 2>/dev/null || true
    fi

    rm -f "${PID_FILE}" "${ADAPTER_PID_FILE}"
    rm -f "${SOCK_FILE}" "${SOCK_FILE_REAL}"
    return 0
}

case "$1" in
    start)  start_process ;;
    stop)   stop_process ;;
    status) status && exit 0 || exit 3 ;;
    *)      echo "Usage: $0 {start|stop|status}"; exit 1 ;;
esac
